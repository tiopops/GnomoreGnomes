rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombres de usuario: UN documento por nombre (en minúsculas).
    // "create" solo funciona si el documento NO existe → dos personas nunca
    // pueden quedarse el mismo nombre. No se pueden editar ni borrar.
    match /usernames/{name} {
      allow get: if true;    // solo contiene uid y nombre: sirve para comprobar si está libre
      allow list: if false;  // nadie puede listar todos los nombres
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.usernameLower == name
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt']);
      allow update: if false;
      // Cambiar de nombre: el dueño libera el nombre anterior.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Para entrar con el NOMBRE de usuario: nombre → correo. Solo se puede leer
    // conociendo el nombre exacto (no se puede listar) y solo se puede crear
    // con el correo de la propia cuenta autenticada.
    match /loginIndex/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Perfil de cada usuario: solo lo ve y lo crea su dueño, y únicamente si
    // reservó ese mismo nombre en la misma operación.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      // Cambiar el nombre de usuario: solo username/usernameLower, y el nuevo nombre
      // debe quedar reservado a su nombre en la misma operación.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'usernameLower', 'nameChangedAt'])
        // Límite: un cambio de nombre cada 7 días (el primero es libre).
        && request.resource.data.nameChangedAt == request.time
        && (!('nameChangedAt' in resource.data) || request.time > resource.data.nameChangedAt + duration.value(7, 'd'))
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if false;
    }
    // Amigos: UN documento por pareja, con id fijo = los dos uid ordenados
    // ("uidMenor_uidMayor"), así es imposible duplicar una amistad.
    //   from -> quien envía la solicitud, to -> quien la recibe.
    // Solo participan los dos usuarios: el receptor acepta, cualquiera de los
    // dos puede borrar (rechazar / cancelar / eliminar amigo).
    match /friends/{pairId} {
      // get: permite comprobar si ya existe la pareja (si no existe, resource es null).
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.users);
      allow list: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'fromName', 'toName', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] == request.resource.data.from
        && request.resource.data.users[1] == request.resource.data.to
        && pairId == (request.resource.data.from < request.resource.data.to
            ? request.resource.data.from + '_' + request.resource.data.to
            : request.resource.data.to + '_' + request.resource.data.from)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.fromName
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.toName.lower())).data.uid == request.resource.data.to;
      allow update: if (request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // Cambio de nombre: cada uno actualiza SU nombre en la amistad.
        || (request.auth != null && resource.data.from == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fromName'])
        && request.resource.data.fromName == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username)
        || (request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toName'])
        && request.resource.data.toName == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username);
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Presencia ("en línea"): cada usuario escribe solo la suya; cualquiera con
    // sesión puede consultar la de un uid concreto (no se puede listar).
    match /presence/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen is number;
      allow delete: if false;
    }

    // Buscar amigos por correo: emails/{correo en minúsculas} -> { uid, username }.
    // Solo se puede leer conociendo el correo exacto (no se puede listar) y solo
    // se crea con el correo de la propia cuenta autenticada.
    match /emails/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.username;
      // Cambio de nombre: solo el campo username, igual al del perfil ya actualizado.
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.username;
      allow delete: if false;
    }

    // Chat efímero entre amigos aceptados. Los mensajes son temporales: el
    // receptor los guarda en memoria y los borra al recibirlos.
    match /chats/{pairId}/msgs/{msgId} {
      function isPair() {
        let f = get(/databases/$(database)/documents/friends/$(pairId));
        return request.auth != null && f.data.status == 'accepted' && request.auth.uid in f.data.users;
      }
      allow read: if isPair();
      allow create: if isPair()
        && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.ts is number;
      allow update: if false;
      allow delete: if isPair();
    }
    // Partidas online 1 contra 1 (js/mp-lobby.js, js/net.js).
    //   rooms/{id}: sala creada por el anfitrión para UN amigo aceptado.
    //   Solo los dos participantes la ven. El anfitrión elige nivel/estado y
    //   su raza; el invitado acepta/rechaza y elige la suya.
    //   rooms/{id}/msgs/*: comandos de la partida (los escribe cada jugador
    //   con su uid en "from") + un documento "ping_<uid>" de latido.
    match /rooms/{roomId} {
      allow get: if request.auth != null
        && (resource == null || resource.data.hostUid == request.auth.uid || resource.data.guestUid == request.auth.uid);
      // Invitaciones recibidas: la consulta debe filtrar por guestUid == tu uid.
      allow list: if request.auth != null && resource.data.guestUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid != request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'guestUid', 'guestName', 'status', 'level',
             'hostRace', 'guestRace', 'hostReady', 'guestReady', 'guestJoined', 'guestDeclined', 'createdAt',
             'mm', 'hostSk', 'guestSk'])
        && (
          // Sala entre amigos: la pareja debe ser amiga aceptada.
          (request.resource.data.get('mm', false) != true
            && get(/databases/$(database)/documents/friends/$(request.resource.data.hostUid < request.resource.data.guestUid
                 ? request.resource.data.hostUid + '_' + request.resource.data.guestUid
                 : request.resource.data.guestUid + '_' + request.resource.data.hostUid)).data.status == 'accepted')
          // Partida Rápida: los dos deben estar en la cola de búsqueda en este momento.
          || (request.resource.data.get('mm', false) == true
            && exists(/databases/$(database)/documents/mmQueue/$(request.resource.data.hostUid))
            && exists(/databases/$(database)/documents/mmQueue/$(request.resource.data.guestUid)))
        );
      allow update: if request.auth != null
        && ((resource.data.hostUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['level', 'hostRace', 'hostReady', 'status', 'seed', 'startedAt']))
            || (resource.data.guestUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['guestJoined', 'guestDeclined', 'guestRace', 'guestReady'])));
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /msgs/{msgId} {
        function inRoom() {
          let r = get(/databases/$(database)/documents/rooms/$(roomId));
          return request.auth != null && (r.data.hostUid == request.auth.uid || r.data.guestUid == request.auth.uid);
        }
        allow read: if inRoom();
        allow create, update: if inRoom() && request.resource.data.from == request.auth.uid;
        allow delete: if inRoom();
      }
    }

    // Estadísticas del jugador (js/stats.js): un documento por usuario, solo lo
    // lee y lo escribe su dueño. Solo números (y el mapa por raza).
    match /stats/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['games', 'wins', 'losses', 'draws', 'streak', 'bestStreak',
             'onlineGames', 'onlineWins', 'aiGames', 'aiWins', 'totems', 'kills', 'races'])
        && request.resource.data.games is number && request.resource.data.wins is number
        && request.resource.data.losses is number && request.resource.data.draws is number
        && request.resource.data.streak is number && request.resource.data.bestStreak is number
        && request.resource.data.onlineGames is number && request.resource.data.onlineWins is number
        && request.resource.data.aiGames is number && request.resource.data.aiWins is number
        && request.resource.data.totems is number && request.resource.data.kills is number
        && request.resource.data.races is map;
      allow delete: if false;
    }

    // Progreso de la cuenta (js/progress.js): XP total, SK (Skill Rating), misiones del día y racha.
    // Solo su dueño lo lee y lo escribe; solo números, textos cortos y mapas.
    match /progress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'xp', 'sk', 'day', 'prog', 'done', 'bonus', 'streak', 'lastDay'])
        && request.resource.data.xp is number && request.resource.data.xp >= 0
        && request.resource.data.sk is number && request.resource.data.sk >= 0 && request.resource.data.sk <= 10000
        && request.resource.data.day is string && request.resource.data.day.size() <= 10
        && request.resource.data.prog is map && request.resource.data.done is map
        && request.resource.data.bonus is number && request.resource.data.streak is number
        && request.resource.data.lastDay is string && request.resource.data.lastDay.size() <= 10;
      allow delete: if false;
    }

    // Gnomoteca (js/gnomoteca.js): lo descubierto, los logros y sus contadores, en UN documento por usuario.
    // ids y a son textos con los identificadores separados por comas; st es un mapa de contadores.
    // Solo su dueño lo lee y lo escribe.
    match /gnomoteca/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'ids', 'a', 'st'])
        && request.resource.data.v == 1
        && request.resource.data.ids is string && request.resource.data.ids.size() <= 6000
        && request.resource.data.a is string && request.resource.data.a.size() <= 3000
        && request.resource.data.st is map && request.resource.data.st.size() <= 40;
      allow delete: if false;
    }

    // Cola de la Partida Rápida (js/matchmaking.js): un ticket por jugador buscando rival.
    //   - Cualquier jugador con sesión puede LEER los tickets (para buscar rival por SK).
    //   - Solo el dueño crea / refresca / borra el suyo.
    //   - Otro jugador solo puede pasarlo de 'searching' a 'matched' enlazándolo a una sala
    //     donde ese jugador es el invitado y quien lo hace es el anfitrión.
    match /mmQueue/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'sk', 'ts', 'status', 'roomId'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'searching'
        && request.resource.data.sk is number && request.resource.data.ts is number
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow update: if request.auth != null
        && ((request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ts', 'status', 'roomId']))
            || (resource.data.status == 'searching'
              && request.resource.data.status == 'matched'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'roomId'])
              && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.guestUid == uid
              && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.hostUid == request.auth.uid));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
