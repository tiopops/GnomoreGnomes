rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombres de usuario: UN documento por nombre (en minúsculas).
    // "create" solo funciona si el documento NO existe → dos personas nunca
    // pueden quedarse el mismo nombre. No se pueden editar ni borrar.
    match /usernames/{name} {
      allow get: if true;    // solo contiene uid y nombre: sirve para comprobar si está libre
      allow list: if false;  // nadie puede listar todos los nombres
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.usernameLower == name
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt']);
      allow update, delete: if false;
    }

    // Para entrar con el NOMBRE de usuario: nombre → correo. Solo se puede leer
    // conociendo el nombre exacto (no se puede listar) y solo se puede crear
    // con el correo de la propia cuenta autenticada.
    match /loginIndex/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Perfil de cada usuario: solo lo ve y lo crea su dueño, y únicamente si
    // reservó ese mismo nombre en la misma operación.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow update, delete: if false;
    }
    // Amigos: UN documento por pareja, con id fijo = los dos uid ordenados
    // ("uidMenor_uidMayor"), así es imposible duplicar una amistad.
    //   from -> quien envía la solicitud, to -> quien la recibe.
    // Solo participan los dos usuarios: el receptor acepta, cualquiera de los
    // dos puede borrar (rechazar / cancelar / eliminar amigo).
    match /friends/{pairId} {
      // get: permite comprobar si ya existe la pareja (si no existe, resource es null).
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.users);
      allow list: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'fromName', 'toName', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] == request.resource.data.from
        && request.resource.data.users[1] == request.resource.data.to
        && pairId == (request.resource.data.from < request.resource.data.to
            ? request.resource.data.from + '_' + request.resource.data.to
            : request.resource.data.to + '_' + request.resource.data.from)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == request.resource.data.fromName
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.toName.lower())).data.uid == request.resource.data.to;
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Presencia ("en línea"): cada usuario escribe solo la suya; cualquiera con
    // sesión puede consultar la de un uid concreto (no se puede listar).
    match /presence/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen is number;
      allow delete: if false;
    }

    // Chat efímero entre amigos aceptados. Los mensajes son temporales: el
    // receptor los guarda en memoria y los borra al recibirlos.
    match /chats/{pairId}/msgs/{msgId} {
      function isPair() {
        let f = get(/databases/$(database)/documents/friends/$(pairId));
        return request.auth != null && f.data.status == 'accepted' && request.auth.uid in f.data.users;
      }
      allow read: if isPair();
      allow create: if isPair()
        && request.resource.data.keys().hasOnly(['from', 'text', 'ts'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.ts is number;
      allow update: if false;
      allow delete: if isPair();
    }
  }
}
